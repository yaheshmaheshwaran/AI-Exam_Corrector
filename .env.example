# Optional. Copy to .env and fill in. Never commit the real .env.
#
# You do not need this file: the application's Settings dialog saves the key to
# your Windows user profile. Use .env only if you would rather keep the key
# beside the project or the executable.
#
# Precedence: GEMINI_API_KEY environment variable > key saved in Settings > this file.
#
# Get a key from https://aistudio.google.com/apikey (GOOGLE_API_KEY works too).
GEMINI_API_KEY=

# Optional overrides
# EXAM_CORRECTOR_MODEL=gemini-3.6-flash
#
# Each model has its own daily free quota, so marking continues down this list
# as each one runs out. Set it empty to keep every paper on one model.
# EXAM_CORRECTOR_FALLBACK_MODELS=gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.7-flash
#
# EXAM_CORRECTOR_EFFORT=high
# EXAM_CORRECTOR_MAX_TOKENS=32000
#
# Page understanding and marking — see ARCHITECTURE.md.
# EXAM_CORRECTOR_LAYOUT_ENGINE=hybrid        # hybrid | vision | local
# EXAM_CORRECTOR_VISION_MODEL=               # defaults to the marking model
# EXAM_CORRECTOR_DIAGRAM_MODEL=              # defaults to the vision model
# EXAM_CORRECTOR_VISUAL_ANALYSIS=true
# EXAM_CORRECTOR_REVIEW_THRESHOLD=0.7
# EXAM_CORRECTOR_MAX_IMAGE_DIM=1600
# EXAM_CORRECTOR_PAGES_PER_REQUEST=2
# EXAM_CORRECTOR_QUESTIONS_PER_REQUEST=8
# EXAM_CORRECTOR_MAX_IMAGES_PER_REQUEST=16
# EXAM_CORRECTOR_TIMEOUT_SECONDS=300
# EXAM_CORRECTOR_RETRIES=2
# EXAM_CORRECTOR_CACHE=true
# EXAM_CORRECTOR_DEBUG=false                 # developer mode: the page inspector
#
# Local handwriting engine (the ocr_service sidecar).
# EXAM_CORRECTOR_OCR_ENABLED=true
# EXAM_CORRECTOR_TROCR_MODEL=microsoft/trocr-large-handwritten
# EXAM_CORRECTOR_OCR_THRESHOLD=0.92
# EXAM_CORRECTOR_OCR_VISION_CHECK=true
# EXAM_CORRECTOR_OCR_DPI=300
# EXAM_CORRECTOR_OCR_ENDPOINT=               # use a running sidecar instead of starting one
# EXAM_CORRECTOR_OCR_TOKEN=

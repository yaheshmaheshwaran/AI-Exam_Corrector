# Optional. Copy to .env and fill in. Never commit the real .env.
#
# You do not need this file: Settings → Models in the app saves the same values
# to your user profile. Precedence: environment variable > Settings > this file.

# Keys (both free)
#
# Gemini reads the pages and marks. https://aistudio.google.com/apikey
# (GOOGLE_API_KEY works too.)
GEMINI_API_KEY=
#
# NVIDIA reads the question paper and writes the answer key (Kimi K3).
# https://build.nvidia.com — phone check, no card.
NVIDIA_API_KEY=

# Which model does each job, first choice first; the rest are backups, used
# when one is out of its daily allowance or not answering. A name starts with
# where the model runs: gemini/, nvidia/, server/ (your GPU server, e.g. Kaggle),
# ollama/ (this computer). Leave unset for these defaults.
#
# EXAM_CORRECTOR_PREP_MODELS=nvidia/moonshotai/kimi-k3,nvidia/z-ai/glm-5.3,gemini/gemini-3.5-flash
# EXAM_CORRECTOR_READER_MODELS=gemini/gemini-3.1-flash-lite,server/Qwen/Qwen3-VL-8B-Instruct
# EXAM_CORRECTOR_MARKER_MODELS=gemini/gemini-3.5-flash,nvidia/moonshotai/kimi-k3

# Your own model servers (optional)
#
# A vLLM server, such as a Kaggle notebook behind a Cloudflare tunnel:
# EXAM_CORRECTOR_MODEL_SERVER_URL=https://<your-tunnel>.trycloudflare.com/v1
# EXAM_CORRECTOR_MODEL_SERVER_KEY=
#
# Ollama on this computer. Its OpenAI-compatible address cannot set the context
# length per request, so start it with a large enough one:
#   OLLAMA_CONTEXT_LENGTH=32768 ollama serve
# EXAM_CORRECTOR_OLLAMA_URL=http://localhost:11434/v1

# Marking
#
# EXAM_CORRECTOR_REVIEW_THRESHOLD=0.7        # marks the AI is less sure of go to review
# EXAM_CORRECTOR_BACKGROUND=false            # true: mark a class by itself, Mac kept awake
# EXAM_CORRECTOR_RETRIES=2                   # retries when a server is busy
# EXAM_CORRECTOR_CACHE=true                  # false: every stage runs again
# EXAM_CORRECTOR_DEBUG=false                 # developer mode: the page inspector
